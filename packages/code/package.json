{
  "name": "@yeytaken/code",
  "description": "Code generation and redemption library with MongoDB adapter.",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./adapters/mongodb": {
      "types": "./dist/adapters/mongodb.d.ts",
      "import": "./dist/adapters/mongodb.mjs",
      "require": "./dist/adapters/mongodb.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:smoke",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/**/*.test.ts\"",
    "test:smoke": "pnpm run build && node --import tsx --test \"test/smoke/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yeyTaken/yeyTaken",
    "directory": "packages/"
  },
  "bugs": {
    "url": "https://github.com/yeyTaken/yeyTaken/issues"
  },
  "homepage": "https://rabbidev.online/",
  "keywords": [
    "code",
    "redeem",
    "voucher",
    "mongodb"
  ],
  "author": {
    "name": "Israel R. Jatobá",
    "organization": "ARC Studio, Inc.",
    "email": "contact.israeljatoba@gmail.com",
    "github": "https://github.com/yeyTaken"
  },
  "license": "MIT",
  "peerDependencies": {
    "mongodb": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@arcstudio/config": "catalog:",
    "mongodb": "^7.0.0",
    "mongodb-memory-server": "^10.3.0",
    "tsx": "catalog:",
    "unbuild": "^3.3.1"
  }
}
